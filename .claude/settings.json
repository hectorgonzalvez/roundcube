{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/revisa-prompt.js",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/format-prettier.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/suggest-skills.sh",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/registra-invocacio-skill.sh",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/oculta-secrets-eixida.js",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/recorda-auditoria.js",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git push*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/recorda-auditoria.js",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/comprova-docmap-commit.js",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/comprova-docmap-commit.js",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/comprova-edicio.js",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/protegix-test-correccio.js",
            "shell": "bash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/injecta-estat-sessio.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/canari.js inicia",
            "shell": "bash"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/exporta-sessio.sh",
            "shell": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/comprova-secrets-commit.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/bloqueja-main.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/bloqueja-main.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/avisa-pr-sense-obri-pr.js",
            "shell": "bash"
          },
          {
            "type": "command",
            "if": "Bash(glab mr create*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/avisa-pr-sense-obri-pr.js",
            "shell": "bash"
          },
          {
            "type": "command",
            "if": "Bash(az repos pr create*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/avisa-pr-sense-obri-pr.js",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/comprova-secrets-commit.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/bloqueja-main.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "if": "PowerShell(git push*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/bloqueja-main.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "if": "PowerShell(gh pr create*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/avisa-pr-sense-obri-pr.js",
            "shell": "bash"
          },
          {
            "type": "command",
            "if": "PowerShell(glab mr create*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/avisa-pr-sense-obri-pr.js",
            "shell": "bash"
          },
          {
            "type": "command",
            "if": "PowerShell(az repos pr create*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/avisa-pr-sense-obri-pr.js",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/refusa-secrets-edicio.sh",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/guarda-shell.js",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/guarda-shell.js",
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/marca-auditoria.sh --fi-torn",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .claude/hooks/encua-auditoria.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node .claude/hooks/canari.js comprova",
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash .claude/hooks/registra-error.sh:*)",
      "Bash(bash .claude/hooks/registra-error.sh *)",
      "Bash(bash .claude/hooks/marca-auditoria.sh:*)",
      "Bash(bash .claude/hooks/marca-auditoria.sh *)",
      "Bash(composer install:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(vendor/bin/php-cs-fixer:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "PowerShell(composer install *)",
      "PowerShell(vendor/bin/phpunit *)",
      "PowerShell(vendor/bin/php-cs-fixer *)",
      "PowerShell(npm run build *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm test *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(composer require:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "PowerShell(npm install *)",
      "PowerShell(composer require *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git reset --hard:*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R*)",
      "Bash(rm * -rf*)",
      "Bash(rm * -fr*)",
      "Bash(rm * -r *)",
      "Bash(sqlplus:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(dotnet user-secrets list*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * +*)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(Remove-Item -r*)",
      "PowerShell(Remove-Item * -r*)",
      "PowerShell(sqlplus *)",
      "PowerShell(dotnet ef database update *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(curl.exe *)",
      "PowerShell(wget.exe *)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(dotnet user-secrets list*)",
      "PowerShell(Get-Content *appsettings.Production.json*)",
      "PowerShell(Get-Content *appsettings.Development.json*)",
      "PowerShell(Get-Content *secrets*)",
      "PowerShell(Get-Content *.pfx*)",
      "PowerShell(Get-Content *.pem*)",
      "Edit(./**/node_modules/**)",
      "Edit(./**/bin/**)",
      "Edit(./**/obj/**)",
      "Edit(./**/dist/**)",
      "Edit(./**/*.min.js)",
      "Edit(./**/*.min.css)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/appsettings.Production.json)",
      "Read(./**/appsettings.Development.json)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pfx)",
      "Read(./**/*.pem)",
      "Read(~/.git-credentials)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/AppData/Roaming/NuGet/NuGet.Config)",
      "Read(~/.nuget/NuGet/NuGet.Config)"
    ]
  }
}
